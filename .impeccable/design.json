  "narrative": {
    "northStar": "The Collector's Desk",
    "overview": "Cool porcelain surfaces, navy ink, and violet selections frame the cards as the richest visual material. The interface is compact and orderly: discovery and deck editing share a working surface, with typography and hairlines carrying hierarchy.",
    "keyCharacteristics": [
      "Quiet neutral surfaces with violet actions and selection.",
      "Compact controls and generous, uncropped card imagery.",
      "A persistent working deck on wide screens; stacked work areas on small screens."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Use the violet family consistently for interactive selection; keep mana colors tied to card identity.",
        "section": "colors"
      },
      {
        "name": "The Focus Rule",
        "body": "Keep the shared visible keyboard outline on interactive controls; preserve reduced-motion behavior when extending components.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use violet for actions and selection, and mana colors for card identity.",
      "Do preserve complete card images and readable names.",
      "Do retain keyboard focus visibility and the reduced-motion override.",
      "Do adapt the working deck into the document flow on narrow screens."
    ],
    "donts": [
      "Don't crop card art to fit landscape tiles.",
      "Don't replace compact information rows with decorative oversized containers."
    ]
  }
